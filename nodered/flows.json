  {
    "id": "mqtt_telemetria",
    "type": "mqtt in",
    "z": "flow_monitor",
    "name": "telemetria de campo",
    "topic": "monitoramento/+/telemetria",
    "qos": "0",
    "datatype": "auto",
    "broker": "broker_local",
    "x": 150,
    "y": 120,
    "wires": [["parse_json"]]
  },
  {
    "id": "parse_json",
    "type": "json",
    "z": "flow_monitor",
    "name": "",
    "property": "payload",
    "action": "obj",
    "x": 350,
    "y": 120,
    "wires": [["separar"]]
  },
  {
    "id": "separar",
    "type": "function",
    "z": "flow_monitor",
    "name": "separar grandezas",
    "func": "// Divide a telemetria em saídas separadas.\nconst p = msg.payload || {};\nconst id = p.device_id || 'desconhecido';\n\n// Saída 1: temperatura\nlet temp = null;\nif (p.temperatura_c !== undefined && p.temperatura_c !== null) {\n    temp = { topic: id, payload: p.temperatura_c };\n}\n\n// Saída 2: vibração (RMS)\nlet vib = null;\nif (p.vibracao) {\n    vib = { topic: id, payload: p.vibracao.rms_g };\n}\n\n// Saída 3: objeto completo para o avaliador de alarmes\nconst full = { payload: p };\n\nreturn [temp, vib, full];",
    "outputs": 3,
    "x": 560,
    "y": 120,
    "wires": [["gauge_temp"], ["chart_vib"], ["avaliar_alarme"]]
  },
  {
    "id": "gauge_temp",
    "type": "ui_gauge",
    "z": "flow_monitor",
    "name": "Temperatura",
    "group": "ui_grp_temp",
    "order": 1,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Temperatura",
    "label": "°C",
    "format": "{{value}}",
    "min": 0,
    "max": 100,
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": 60,
    "seg2": 75,
    "x": 820,
    "y": 80,
    "wires": []
  },
  {
    "id": "chart_vib",
    "type": "ui_chart",
    "z": "flow_monitor",
    "name": "Vibração RMS",
    "group": "ui_grp_vib",
    "order": 1,
    "width": 6,
    "height": 4,
    "label": "Vibração RMS (g)",
    "chartType": "line",
    "legend": "false",
    "ymin": "0",
    "ymax": "",
    "removeOlder": "1",
    "removeOlderUnit": "3600",
    "x": 820,
    "y": 140,
    "wires": [[]]
  },
  {
    "id": "avaliar_alarme",
    "type": "function",
    "z": "flow_monitor",
    "name": "avaliar limites",
    "func": "// Limites de alarme — calibre conforme o equipamento.\nconst LIM = {\n    temp:  { atencao: 60,  critico: 75 },\n    vibRms:{ atencao: 0.5, critico: 1.0 }\n};\n\nconst p = msg.payload || {};\nconst id = p.device_id || 'desconhecido';\nlet nivel = 'normal';\nconst motivos = [];\n\nfunction avalia(valor, lim, nome, unid) {\n    if (valor === undefined || valor === null) return;\n    if (valor >= lim.critico) {\n        nivel = 'critico';\n        motivos.push(`${nome} crítico: ${valor}${unid}`);\n    } else if (valor >= lim.atencao) {\n        if (nivel !== 'critico') nivel = 'atencao';\n        motivos.push(`${nome} em atenção: ${valor}${unid}`);\n    }\n}\n\navalia(p.temperatura_c, LIM.temp, 'Temperatura', '°C');\nif (p.vibracao) avalia(p.vibracao.rms_g, LIM.vibRms, 'Vibração RMS', 'g');\n\nconst cores = { normal: '#00b500', atencao: '#e6e600', critico: '#ca3838' };\nmsg.payload = motivos.length ? `${id}: ${motivos.join(' | ')}` : `${id}: OK`;\nmsg.color = cores[nivel];\nmsg.nivel = nivel;\nreturn msg;",
    "outputs": 1,
    "x": 810,
    "y": 220,
    "wires": [["status_alarme", "debug_alarme"]]
  },
  {
    "id": "status_alarme",
    "type": "ui_text",
    "z": "flow_monitor",
    "group": "ui_grp_alarm",
    "order": 1,
    "width": 6,
    "height": 2,
    "name": "Status",
    "label": "Status",
    "format": "<span style=\"color:{{msg.color}}\">{{msg.payload}}</span>",
    "layout": "row-left",
    "x": 1030,
    "y": 200,
    "wires": []
  },
  {
    "id": "debug_alarme",
    "type": "debug",
    "z": "flow_monitor",
    "name": "alarme",
    "active": true,
    "console": false,
    "complete": "payload",
    "x": 1030,
    "y": 260,
    "wires": []
  },
  {
    "id": "mqtt_corrente",
    "type": "mqtt in",
    "z": "flow_monitor",
    "name": "corrente PowerFlex 525",
    "topic": "monitoramento/+/corrente",
    "qos": "0",
    "datatype": "auto",
    "broker": "broker_local",
    "x": 170,
    "y": 320,
    "wires": [["parse_corrente"]]
  },
  {
    "id": "parse_corrente",
    "type": "function",
    "z": "flow_monitor",
    "name": "extrai corrente (A)",
    "func": "// Recebe o que o sidecar pycomm3 publica em monitoramento/<id>/corrente.\n// Aceita objeto { corrente_a: <valor> } ou numero puro.\nlet v = msg.payload;\nif (v && typeof v === 'object') { v = v.corrente_a; }\nv = Number(v);\nif (!isFinite(v)) { return null; }\nconst id = (msg.topic || '').split('/')[1] || 'powerflex';\nmsg.topic = id;\nmsg.payload = Math.round(v * 10) / 10;\nreturn msg;",
    "outputs": 1,
    "x": 450,
    "y": 320,
    "wires": [["gauge_corr"]]
  },
  {
    "id": "gauge_corr",
    "type": "ui_gauge",
    "z": "flow_monitor",
    "name": "Corrente",
    "group": "ui_grp_corr",
    "order": 1,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Corrente",
    "label": "A",
    "format": "{{value}}",
    "min": 0,
    "max": 50,
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": 40,
    "seg2": 45,
    "x": 700,
    "y": 320,
    "wires": []
  },
  {
    "id": "ui_grp_disp",
    "type": "ui_group",
    "name": "Dispositivo de campo",
    "tab": "ui_tab_1",
    "order": 5,
    "disp": true,
    "width": 6
  },
  {
    "id": "mqtt_status",
    "type": "mqtt in",
    "z": "flow_monitor",
    "name": "status de campo (online/offline)",
    "topic": "monitoramento/+/status",
    "qos": "1",
    "datatype": "utf8",
    "broker": "broker_local",
    "x": 180,
    "y": 440,
    "wires": [["fmt_status"]]
  },
  {
    "id": "fmt_status",
    "type": "function",
    "z": "flow_monitor",
    "name": "formata status",
    "func": "const id = (msg.topic || '').split('/')[1] || 'dispositivo';\nconst online = String(msg.payload).trim() === 'online';\nmsg.payload = `${id}: ${online ? 'ONLINE' : 'OFFLINE'}`;\nmsg.color = online ? '#00b500' : '#ca3838';\nreturn msg;",
    "outputs": 1,
    "x": 440,
    "y": 440,
    "wires": [["txt_conexao"]]
  },
  {
    "id": "txt_conexao",
    "type": "ui_text",
    "z": "flow_monitor",
    "group": "ui_grp_disp",
    "order": 1,
    "width": 6,
    "height": 1,
    "name": "Conexão",
    "label": "Conexão",
    "format": "<span style=\"color:{{msg.color}}\">{{msg.payload}}</span>",
    "layout": "row-left",
    "x": 660,
    "y": 440,
    "wires": []
  },
  {
    "id": "btn_publicar",
    "type": "ui_button",
    "z": "flow_monitor",
    "name": "Publicar agora",
    "group": "ui_grp_disp",
    "order": 2,
    "width": 6,
    "height": 1,
    "label": "Publicar agora",
    "tooltip": "Solicita uma leitura imediata ao ESP32",
    "color": "",
    "bgcolor": "",
    "className": "",
    "icon": "",
    "payload": "publicar",
    "payloadType": "str",
    "topic": "",
    "topicType": "str",
    "x": 180,
    "y": 520,
    "wires": [["monta_cmd"]]
  },
  {
    "id": "monta_cmd",
    "type": "function",
    "z": "flow_monitor",
    "name": "monta comando",
    "func": "// Ajuste o device_id de destino conforme o equipamento.\nconst deviceId = 'motor-01';\nmsg.topic = `monitoramento/${deviceId}/cmd`;\nmsg.payload = JSON.stringify({ comando: 'publicar' });\nreturn msg;",
    "outputs": 1,
    "x": 430,
    "y": 520,
    "wires": [["mqtt_cmd"]]
  },
  {
    "id": "mqtt_cmd",
    "type": "mqtt out",
    "z": "flow_monitor",
    "name": "comando -> ESP32",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "broker": "broker_local",
    "x": 680,
    "y": 520,
    "wires": []
  }
]
