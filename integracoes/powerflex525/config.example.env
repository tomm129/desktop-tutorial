# Copie para config.env e ajuste. Carregue com: set -a; . ./config.env; set +a
#
# ATENCAO: comentario so vale em linha PROPRIA, comecando com "#".
# O EnvironmentFile= do systemd NAO corta comentario no fim da linha — ele
# viraria parte do valor, e o float()/int() do powerflex_mqtt.py estouraria
# na inicializacao do servico (com Restart=always, em crash-loop).
# O bash corta e disfarca o problema; o systemd nao.

# --- PowerFlex 525 (EtherNet/IP) ---

# IP do inversor na rede EtherNet/IP
PF525_IP=192.168.1.10

# Identificador usado nos topicos MQTT
PF525_DEVICE_ID=powerflex-01

# Periodo de leitura, em segundos
PF525_INTERVALO_S=1.0

# Classe CIP do objeto de parametros (520COM-UM001, Apendice C):
#   0x0F Parameter Object      (padrao)
#   0x93 DPI Parameter Object  (se a 0x0F nao responder)
# O codigo escolhe sozinho o atributo certo de cada uma (1 e 9).
PF525_CLASSE=0x0F

# Envio da mensagem CIP: auto (padrao) | sim | nao
# O manual nao deixa claro se o adaptador embarcado aceita o envelope
# Unconnected Send. Em 'auto' o sidecar tenta com e, se o drive recusar,
# sem -- e guarda o que funcionou. A --bancada mostra qual foi.
PF525_UNCONNECTED_SEND=auto

# --- Escalas: bruto -> unidade de engenharia ---
#
# O valor lido e inteiro; a escala converte. Conferidas no 520-UM001
# (campo "Display" de cada parametro):
#   b001 0.01 Hz | b003 0.01 A | b004 0.1 V | b005 1 V DC
#
# ATENCAO: o b005 e em VOLTS INTEIROS. Versoes anteriores deste arquivo
# traziam PF525_ESCALA_DCBUS=0.1, e 311 V apareciam como 31,1 V. Se o seu
# config.env foi copiado de uma delas, CORRIJA a linha la tambem: a
# variavel de ambiente vence o padrao do codigo.
#
# Confira com a bancada:  python powerflex_mqtt.py --bancada

PF525_ESCALA_FREQ=0.01
PF525_ESCALA_CORRENTE=0.01
PF525_ESCALA_TENSAO=0.1
PF525_ESCALA_DCBUS=1.0

# Loga os valores brutos a cada leitura -- use so durante a calibracao
# das escalas acima.
PF525_LOG_BRUTO=0

# Abaixo desta frequencia de saida (Hz), o motor e considerado parado.
PF525_FREQ_PARADO_HZ=0.1

# --- MQTT (broker no Orange Pi) ---

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
