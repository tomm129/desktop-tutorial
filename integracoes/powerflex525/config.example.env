# Copie para config.env e ajuste. Carregue com: set -a; . ./config.env; set +a

# --- PowerFlex 525 (EtherNet/IP) ---
PF525_IP=192.168.1.10          # IP do inversor na rede EtherNet/IP
PF525_DEVICE_ID=powerflex-01   # identificador usado nos tópicos MQTT
PF525_PARAM_INSTANCE=3         # b003 = Corrente de Saída (A)
PF525_ESCALA=0.01              # bruto -> Amperes; confirme com o display b003
PF525_INTERVALO_S=1.0          # período de leitura, em segundos

# --- MQTT (broker no Orange Pi) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
