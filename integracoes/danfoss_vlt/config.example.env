# Sidecar Danfoss VLT — copie para config.env e ajuste.
# O config.env NAO e versionado (guarda a senha do broker).

# --- Familia do drive ------------------------------------------------
# fc302 (ou fc301) = AutomationDrive: grupo 16 completo, COM 16-17 Speed
#                    [RPM] e 16-16 Torque
# fc51             = Micro Drive: NAO tem 16-16 nem 16-17
#
# Errar aqui nao e fatal (o sidecar abandona o parametro que o drive
# recusar e segue), mas gera um aviso por parametro na primeira leitura.
DANFOSS_FAMILIA=fc302

# --- Transporte ------------------------------------------------------
# tcp = Modbus TCP (exige placa Ethernet no drive: MCA 121 no FC 302)
# rtu = Modbus RTU sobre RS-485 (embutido na maioria dos FC, sem opcional)
DANFOSS_TRANSPORTE=tcp

# Modbus TCP
DANFOSS_IP=192.168.1.30
DANFOSS_PORTA=502

# Modbus RTU
DANFOSS_SERIAL=/dev/ttyUSB0
DANFOSS_BAUD=9600

# Endereco do escravo = parametro 8-31 do drive.
DANFOSS_UNIT=1

# parametro = le um PNU por vez (funciona sem configurar o drive)
# pcd       = le o bloco 2910-2919 numa transacao so (RAPIDO, mas exige
#             configurar o parametro 12-22 no drive antes)
DANFOSS_MODO=parametro

DANFOSS_INTERVALO_S=1.0

# Ligue na primeira instalacao: loga o valor BRUTO de cada parametro.
# Compare com o display do drive antes de confiar nas escalas.
DANFOSS_LOG_BRUTO=0

# --- Identidade e MQTT ----------------------------------------------
# Este e o id que vai no topico e no cadastro de ativos do painel.
DEVICE_ID=danfoss-01

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_BASE_TOPIC=monitoramento

# --- Escalas ---------------------------------------------------------
# O ponto mais provavel de erro, porque o "conversion index" varia entre
# familias (FC 51 x FC 302 x FC 360). Descubra com DANFOSS_LOG_BRUTO=1:
# se o display marca 12,3 A e o bruto e 1230, a escala e 0.01.
# DANFOSS_ESCALA_CORRENTE=0.01
# DANFOSS_ESCALA_TENSAO=0.1
# DANFOSS_ESCALA_FREQ=0.1
# DANFOSS_ESCALA_DCBUS=1.0
# DANFOSS_ESCALA_RPM=1.0
# DANFOSS_ESCALA_POTENCIA=0.01
# DANFOSS_ESCALA_TORQUE=0.1

# Abaixo disto o motor conta como parado.
DANFOSS_FREQ_PARADO_HZ=0.5
