# Copie para .env e preencha. NUNCA commite o .env.
# Prefixo CRYPTOBOT_, aninhamento com __ (ex.: CRYPTOBOT_TELEGRAM__BOT_TOKEN)

# Pares e timeframes (JSON)
# CRYPTOBOT_SYMBOLS=["BTC/USDT:USDT","ETH/USDT:USDT","SOL/USDT:USDT"]
# CRYPTOBOT_TIMEFRAMES=["15m","1h","4h"]

# Telegram (opcional — alertas desabilitados se vazio)
CRYPTOBOT_TELEGRAM__ENABLED=false
CRYPTOBOT_TELEGRAM__BOT_TOKEN=
CRYPTOBOT_TELEGRAM__CHAT_ID=

# Coleta
CRYPTOBOT_COLLECTION__INTERVAL_SECONDS=900
# 50 dias => 300 candles de 4h no primeiro boot (200 warm-up features + 50 regime)
CRYPTOBOT_COLLECTION__BACKFILL_DAYS=50

# Paper trading (fase de pesquisa: sempre true)
CRYPTOBOT_PAPER_TRADING__ENABLED=true

# Banco
CRYPTOBOT_DATABASE__PATH=data/crypto_bot.duckdb
CRYPTOBOT_DATABASE__BACKUP_DIR=data/backups
