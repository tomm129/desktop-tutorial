; Arquivo de configuração do projeto Godot.
; Você abre este projeto na Godot Engine (versão 4.3 ou mais nova).

config_version=5

[application]

config/name="Brawl Coop - Prototipo"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3")

[autoload]

; Roda antes da cena principal: e ele que monta um patch ja baixado.
Controles="*res://Controles.gd"
Rede="*res://Rede.gd"
Atualizador="*res://Atualizador.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"

[rendering]

; Pixel art: sem isso a Godot suaviza a textura e os sprites saem borrados.
textures/canvas_textures/default_texture_filter=0
